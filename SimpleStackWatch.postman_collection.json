              }
            },
            "url": "{{baseUrl}}{{mcpPath}}",
            "description": "Protocol-level connectivity check; not the health status of any monitored target."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
                  "const raw = pm.response.text();",
                  "const request = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
                  "let message;",
                  "if (/text\\/event-stream/i.test(contentType)) {",
                  "    const events = raw.replace(/\\r\\n/g, \"\\n\").split(/\\n\\n/);",
                  "    for (const event of events) {",
                  "        const data = event.split(\"\\n\").filter(line => line.startsWith(\"data:\"))",
                  "            .map(line => line.slice(5).replace(/^ /, \"\")).join(\"\\n\");",
                  "        if (!data) continue;",
                  "        let candidate;",
                  "        try { candidate = JSON.parse(data); } catch (_) { continue; }",
                  "        if (candidate && candidate.id === request.id) { message = candidate; break; }",
                  "    }",
                  "} else if (/application\\/json/i.test(contentType)) {",
                  "    try { message = JSON.parse(raw); } catch (_) { /* assertion below reports failure */ }",
                  "}",
                  "pm.test(\"Matching JSON-RPC success response\", () => {",
                  "    pm.expect(message, \"Expected a JSON or SSE JSON-RPC reply\").to.be.an(\"object\");",
                  "    pm.expect(message.jsonrpc).to.equal(\"2.0\");",
                  "    pm.expect(message.id).to.equal(request.id);",
                  "    pm.expect(message).not.to.have.property(\"error\");",
                  "    pm.expect(message).to.have.property(\"result\");",
                  "});",
                  "pm.test(\"Ping returns a result object\", () => pm.expect(message.result).to.be.an(\"object\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 List tools",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream",
                "type": "text"
              },
              {
                "key": "MCP-Protocol-Version",
                "value": "{{protocolVersion}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 3,\n  \"method\": \"tools/list\",\n  \"params\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}{{mcpPath}}",
            "description": "Discover tools and their input schemas. Four monitoring tools are currently expected."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
                  "const raw = pm.response.text();",
                  "const request = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
                  "let message;",
                  "if (/text\\/event-stream/i.test(contentType)) {",
                  "    const events = raw.replace(/\\r\\n/g, \"\\n\").split(/\\n\\n/);",
                  "    for (const event of events) {",
                  "        const data = event.split(\"\\n\").filter(line => line.startsWith(\"data:\"))",
                  "            .map(line => line.slice(5).replace(/^ /, \"\")).join(\"\\n\");",
                  "        if (!data) continue;",
                  "        let candidate;",
                  "        try { candidate = JSON.parse(data); } catch (_) { continue; }",
                  "        if (candidate && candidate.id === request.id) { message = candidate; break; }",
                  "    }",
                  "} else if (/application\\/json/i.test(contentType)) {",
                  "    try { message = JSON.parse(raw); } catch (_) { /* assertion below reports failure */ }",
                  "}",
                  "pm.test(\"Matching JSON-RPC success response\", () => {",
                  "    pm.expect(message, \"Expected a JSON or SSE JSON-RPC reply\").to.be.an(\"object\");",
                  "    pm.expect(message.jsonrpc).to.equal(\"2.0\");",
                  "    pm.expect(message.id).to.equal(request.id);",
                  "    pm.expect(message).not.to.have.property(\"error\");",
                  "    pm.expect(message).to.have.property(\"result\");",
                  "});",
                  "pm.test(\"All four monitoring tools are advertised\", () => {",
                  "    const tools = message.result.tools;",
                  "    pm.expect(tools).to.be.an(\"array\");",
                  "    for (const name of [\"get_overview\", \"list_targets\", \"get_target_status\", \"get_target_history\"]) {",
                  "        pm.expect(tools.some(tool => tool.name === name), name).to.equal(true);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 — Monitoring tools",
      "item": [
        {
          "name": "05 Get overview",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream",
                "type": "text"
              },
              {
                "key": "MCP-Protocol-Version",
                "value": "{{protocolVersion}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 4,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"get_overview\",\n    \"arguments\": {}\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}{{mcpPath}}",
            "description": "Current cached health of every configured target, including summary counts. Empty targets are valid."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
                  "const raw = pm.response.text();",
                  "const request = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
                  "let message;",
                  "if (/text\\/event-stream/i.test(contentType)) {",
                  "    const events = raw.replace(/\\r\\n/g, \"\\n\").split(/\\n\\n/);",
                  "    for (const event of events) {",
                  "        const data = event.split(\"\\n\").filter(line => line.startsWith(\"data:\"))",
                  "            .map(line => line.slice(5).replace(/^ /, \"\")).join(\"\\n\");",
                  "        if (!data) continue;",
                  "        let candidate;",
                  "        try { candidate = JSON.parse(data); } catch (_) { continue; }",
                  "        if (candidate && candidate.id === request.id) { message = candidate; break; }",
                  "    }",
                  "} else if (/application\\/json/i.test(contentType)) {",
                  "    try { message = JSON.parse(raw); } catch (_) { /* assertion below reports failure */ }",
                  "}",
                  "pm.test(\"Matching JSON-RPC success response\", () => {",
                  "    pm.expect(message, \"Expected a JSON or SSE JSON-RPC reply\").to.be.an(\"object\");",
                  "    pm.expect(message.jsonrpc).to.equal(\"2.0\");",
                  "    pm.expect(message.id).to.equal(request.id);",
                  "    pm.expect(message).not.to.have.property(\"error\");",
                  "    pm.expect(message).to.have.property(\"result\");",
                  "});",
                  "function readToolData(result) {",
                  "    if (!result || result.isError === true) throw new Error(\"MCP tool failed\");",
                  "    const texts = (result.content || []).filter(item => item.type === \"text\");",
                  "    if (texts.length) return JSON.parse(texts.map(item => item.text).join(\"\"));",
                  "    if (result.structuredContent !== undefined) return result.structuredContent;",
                  "    throw new Error(\"Missing tool payload\");",
                  "}",
                  "pm.test(\"Valid get_overview payload\", () => {",
                  "    const data = readToolData(message && message.result);",
                  "    pm.expect(data).to.be.an(\"object\");",
                  "    pm.expect(data.targets).to.be.an(\"array\");",
                  "    pm.expect(data.summary.total).to.equal(data.targets.length);",
                  "});"
                ]
              }
            }
          ]
        },
