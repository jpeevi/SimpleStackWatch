            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"notifications/initialized\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}{{mcpPath}}",
            "description": "Send after Initialize. Notifications have no JSON-RPC id and a successful server returns HTTP 202 with no response body."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Notification accepted (202)\", () => pm.response.to.have.status(202));",
                  "pm.test(\"No JSON-RPC response body\", () => pm.expect(pm.response.text().trim()).to.equal(\"\"));"
                ]
              }
            }
          ]
        },
        {
