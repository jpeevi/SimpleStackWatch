              }
            }
          ]
        },
        {
          "name": "08 Get target history",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream",
                "type": "text"
              },
              {
                "key": "MCP-Protocol-Version",
                "value": "{{protocolVersion}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 7,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"get_target_history\",\n    \"arguments\": {\n      \"targetId\": {{targetIdJson}},\n      \"limit\": {{historyLimitJson}}\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}{{mcpPath}}",
            "description": "Requires targetId; historyLimit defaults to 50 (1–200). Empty history is valid before the first recorded check."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const targetId = pm.variables.get(\"targetId\");",
                  "if (typeof targetId !== \"string\" || !targetId.trim()) {",
                  "    throw new Error(\"Set targetId locally using a configured ID from List targets before sending this request.\");",
                  "}",
                  "pm.variables.set(\"targetIdJson\", JSON.stringify(targetId));",
                  "const limit = Number(pm.variables.get(\"historyLimit\"));",
                  "if (!Number.isInteger(limit) || limit < 1 || limit > 200) {",
                  "    throw new Error(\"historyLimit must be an integer between 1 and 200.\");",
                  "}",
                  "pm.variables.set(\"historyLimitJson\", String(limit));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
                  "const raw = pm.response.text();",
                  "const request = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
                  "let message;",
                  "if (/text\\/event-stream/i.test(contentType)) {",
                  "    const events = raw.replace(/\\r\\n/g, \"\\n\").split(/\\n\\n/);",
                  "    for (const event of events) {",
                  "        const data = event.split(\"\\n\").filter(line => line.startsWith(\"data:\"))",
                  "            .map(line => line.slice(5).replace(/^ /, \"\")).join(\"\\n\");",
                  "        if (!data) continue;",
                  "        let candidate;",
                  "        try { candidate = JSON.parse(data); } catch (_) { continue; }",
                  "        if (candidate && candidate.id === request.id) { message = candidate; break; }",
                  "    }",
                  "} else if (/application\\/json/i.test(contentType)) {",
                  "    try { message = JSON.parse(raw); } catch (_) { /* assertion below reports failure */ }",
                  "}",
                  "pm.test(\"Matching JSON-RPC success response\", () => {",
                  "    pm.expect(message, \"Expected a JSON or SSE JSON-RPC reply\").to.be.an(\"object\");",
                  "    pm.expect(message.jsonrpc).to.equal(\"2.0\");",
                  "    pm.expect(message.id).to.equal(request.id);",
                  "    pm.expect(message).not.to.have.property(\"error\");",
                  "    pm.expect(message).to.have.property(\"result\");",
                  "});",
                  "function readToolData(result) {",
                  "    if (!result || result.isError === true) throw new Error(\"MCP tool failed\");",
                  "    const texts = (result.content || []).filter(item => item.type === \"text\");",
                  "    if (texts.length) return JSON.parse(texts.map(item => item.text).join(\"\"));",
                  "    if (result.structuredContent !== undefined) return result.structuredContent;",
                  "    throw new Error(\"Missing tool payload\");",
                  "}",
                  "pm.test(\"Valid get_target_history payload\", () => {",
                  "    const data = readToolData(message && message.result);",
                  "    pm.expect(data).to.be.an(\"array\");",
                  "    pm.expect(data.length).to.be.at.most(request.params.arguments.limit);",
                  "    for (const row of data) pm.expect(row.status).to.be.oneOf([\"Healthy\", \"Degraded\", \"Down\", \"Unknown\"]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 — Authentication checks",
      "item": [
        {
          "name": "09 Missing token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream",
                "type": "text"
              },
              {
                "key": "MCP-Protocol-Version",
                "value": "{{protocolVersion}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 8,\n  \"method\": \"ping\",\n  \"params\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}{{mcpPath}}",
            "description": "Explicitly disables inherited collection authentication. With MCP enabled, expect 401; when disabled the route returns 404 instead.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"MCP rejects unauthorized request (401)\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Bearer authentication challenge\", () => {",
                  "    pm.expect(pm.response.headers.get(\"WWW-Authenticate\") || \"\").to.match(/^Bearer(?:\\s|$)/i);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "10 Invalid token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream",
                "type": "text"
              },
              {
                "key": "MCP-Protocol-Version",
                "value": "{{protocolVersion}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer intentionally-invalid-example-token",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 9,\n  \"method\": \"ping\",\n  \"params\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}{{mcpPath}}",
            "description": "Uses a fixed intentionally invalid token, not the configured secret. With MCP enabled, expect 401.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"MCP rejects unauthorized request (401)\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Bearer authentication challenge\", () => {",
                  "    pm.expect(pm.response.headers.get(\"WWW-Authenticate\") || \"\").to.match(/^Bearer(?:\\s|$)/i);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
