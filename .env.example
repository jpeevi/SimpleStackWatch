# Documentation only. Do not put real private values in this tracked file.
# Create /etc/monitor-dashboard.env (outside the repository) with mode 0600.
# Use systemd EnvironmentFile key=value syntax; uncomment only what you need.
# Set the service's ASPNETCORE_ENVIRONMENT separately in its unit or override.

# Paths and other host-specific settings:
# Dashboard__DataDirectory=/var/lib/monitor-dashboard
# Dashboard__Logs__Folder=/var/log/monitor-dashboard
# LogSettings__FilePath=/var/log/monitor-dashboard/app-.log
# Dashboard__Logs__Folders__0__Id=application
# Dashboard__Logs__Folders__0__Name=Application
# Dashboard__Logs__Folders__0__Folder=/private/path/to/application/logs

# Database log viewer:
# Dashboard__Logs__Database__ConnectionString="Host=DB_HOST;Database=DB_NAME;Username=DB_USER;Password=DB_PASSWORD"
# Dashboard__Logs__Database__Schema=public
# Dashboard__Logs__Database__Table=logs

# Monitoring infrastructure (numbered collections begin at 0):
# Dashboard__Monitoring__Endpoints__0__Id=web-api
# Dashboard__Monitoring__Endpoints__0__Name=Web API
# Dashboard__Monitoring__Endpoints__0__Environment=Uat
# Dashboard__Monitoring__Endpoints__0__Group=Applications
# Dashboard__Monitoring__Endpoints__0__Url=https://your-private-host.example/health
# Dashboard__Monitoring__Endpoints__0__HeaderName=Authorization
# Dashboard__Monitoring__Endpoints__0__HeaderValue="Bearer REPLACE_WITH_PRIVATE_TOKEN"

# Endpoint availability example (use next free index; no AWS credentials needed):
# Dashboard__Monitoring__Endpoints__1__Id=object-storage
# Dashboard__Monitoring__Endpoints__1__Name="Object storage endpoint"
# Dashboard__Monitoring__Endpoints__1__Environment=Uat
# Dashboard__Monitoring__Endpoints__1__Group=Infrastructure
# Dashboard__Monitoring__Endpoints__1__Url=https://s3.us-east-1.amazonaws.com
# Dashboard__Monitoring__Endpoints__1__ReachabilityOnly=true
# Dashboard__Monitoring__Linux__Environment=Uat
# Dashboard__Monitoring__Linux__Group=Host
# Dashboard__Monitoring__Linux__DiskPaths__0=/
# Dashboard__Monitoring__Linux__Services__0=your-service.service
# Dashboard__Monitoring__Alerts__WebhookUrl=https://your-private-alert-receiver.example/hooks/monitoring

# Database and cache:
# Dashboard__Postgres__Databases__0__Name=Application
# Dashboard__Postgres__Databases__0__ConnectionString="Host=DB_HOST;Database=DB_NAME;Username=DB_USER;Password=DB_PASSWORD"
# Dashboard__Postgres__Environment=Uat
# Dashboard__Redis__ConnectionString="REDIS_HOST:6379,password=REPLACE_WITH_PASSWORD,allowAdmin=true"
# Dashboard__Redis__Environment=Uat

# AWS identity/credentials should use a dedicated IAM role wherever possible.
# Dashboard__Aws__Enabled=true
# Dashboard__Aws__Region=YOUR_REGION
# Dashboard__Aws__InstanceIds__0=i-your-instance-id
# Dashboard__Aws__Environment=Uat

# Optional diagnostics bridge:
# Dashboard__Processes__Monitor__BaseUrl=http://127.0.0.1:52323
# Dashboard__Processes__Monitor__ApiKey=REPLACE_WITH_PRIVATE_API_KEY
# Dashboard__Processes__AllowedProcessIds__0=1234

# Optional MCP; choose a fresh randomly generated 64-hex-character token.
# Dashboard__Mcp__Enabled=true
# Dashboard__Mcp__BearerToken=REPLACE_WITH_FRESH_RANDOM_TOKEN

# Optional external hostname for ASP.NET Core host filtering:
# AllowedHosts=stackwatch.your-domain.example
