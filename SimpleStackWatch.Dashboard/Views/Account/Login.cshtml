@{ ViewData["Title"] = "Sign in"; }
<div class="auth-panel card border-0 shadow-sm"><div class="card-body p-4">
<h1 class="h4 mb-1">Sign in</h1><p class="text-secondary small mb-4">Use your dashboard account.</p>
@if (ViewData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
<form action="/account/login" method="post">@Html.AntiForgeryToken()
<label class="form-label" for="username">Username</label><input class="form-control mb-3" id="username" name="username" autocomplete="username" maxlength="256" required autofocus>
<label class="form-label" for="password">Password</label><input class="form-control mb-4" id="password" name="password" type="password" autocomplete="current-password" maxlength="1024" required>
<button class="btn btn-primary w-100">Continue</button></form>
<p class="small text-secondary mt-4 mb-0">Account creation and resets are handled on the server.</p>
</div></div>
