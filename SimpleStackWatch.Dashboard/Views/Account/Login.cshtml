@{ ViewData["Title"] = "Sign in"; }
<div class="auth-panel card">
    <div class="card-body p-4 p-sm-5">
        <h1 class="h3 mb-4">Sign in</h1>
        @if (ViewData["Error"] is string error)
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }
        <form action="/account/login" method="post">
            @Html.AntiForgeryToken()
            <label class="form-label" for="username">Username</label>
            <input class="form-control mb-3" id="username" name="username" autocomplete="username" maxlength="256" required autofocus>
            <label class="form-label" for="password">Password</label>
            <input class="form-control mb-4" id="password" name="password" type="password"
                   autocomplete="current-password" maxlength="1024" required>
            <button type="submit" class="btn btn-primary w-100">Sign in</button>
        </form>
    </div>
</div>
