@{
    var currentTab = ViewContext.RouteData.Values["tab"]?.ToString() ?? "overview";
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] · SimpleStackWatch</title>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/vendor/bootstrap.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body class="@(signedIn ? "has-sidebar" : "auth-layout")">
<a class="skip-link" href="#main-content">Skip to main content</a>
@if (signedIn)
{
    <div id="menu-backdrop" class="menu-backdrop" hidden></div>
    <aside id="sidebar-menu" class="sidebar" aria-label="Primary navigation">
        <div class="sidebar-heading">
            <a class="sidebar-brand" href="/dashboard/overview">SSW <span class="text-secondary">/ Monitor</span></a>
            <button id="menu-close" class="btn btn-sm btn-outline-secondary sidebar-close" type="button" aria-label="Close navigation">Close</button>
        </div>
        <nav class="sidebar-nav" aria-label="Monitoring sections">
            <p class="sidebar-group">Workspace</p>
            <a class="sidebar-link @(currentTab == "overview" ? "is-active" : "")"
               aria-current="@(currentTab == "overview" ? "page" : null)" href="/dashboard/overview">Overview</a>
            <p class="sidebar-group">Applications</p>
            <a class="sidebar-link @(currentTab == "logs" ? "is-active" : "")"
               aria-current="@(currentTab == "logs" ? "page" : null)" href="/dashboard/logs">Logs</a>
            <a class="sidebar-link @(currentTab == "processes" ? "is-active" : "")"
               aria-current="@(currentTab == "processes" ? "page" : null)" href="/dashboard/processes">.NET processes</a>
            <a class="sidebar-link @(currentTab == "endpoints" ? "is-active" : "")"
               aria-current="@(currentTab == "endpoints" ? "page" : null)" href="/dashboard/endpoints">Endpoints</a>
            <p class="sidebar-group">Infrastructure</p>
            <a class="sidebar-link @(currentTab == "postgres" ? "is-active" : "")"
               aria-current="@(currentTab == "postgres" ? "page" : null)" href="/dashboard/postgres">PostgreSQL</a>
            <a class="sidebar-link @(currentTab == "redis" ? "is-active" : "")"
               aria-current="@(currentTab == "redis" ? "page" : null)" href="/dashboard/redis">Redis</a>
            <a class="sidebar-link @(currentTab == "ec2" ? "is-active" : "")"
               aria-current="@(currentTab == "ec2" ? "page" : null)" href="/dashboard/ec2">EC2</a>
        </nav>
        <div class="sidebar-footer">SimpleStackWatch / Monitoring</div>
    </aside>
}
<div id="app-shell">
    <header class="app-header">
        <div class="app-header-inner">
            @if (signedIn)
            {
                <button id="menu-toggle" type="button" class="btn btn-sm btn-outline-secondary menu-toggle"
                        aria-label="Open navigation" aria-controls="sidebar-menu" aria-expanded="false">
                    Menu
                </button>
            }
            <a href="@(signedIn ? "/dashboard/overview" : "/account/login")" class="brand"><span class="brand-long">SimpleStackWatch</span><span class="brand-short" aria-hidden="true">SSW</span></a>
            <span class="header-divider" aria-hidden="true">/</span>
            <span class="header-context">@(signedIn ? "Monitoring" : "Secure access")</span>
            <div class="header-actions">
                @if (signedIn)
                {
                    <span class="account-name" title="@(User.Identity?.Name)">@(User.Identity?.Name)</span>
                }
                <button id="theme-toggle" type="button" class="btn btn-sm btn-outline-secondary"
                        aria-label="Switch color theme" aria-pressed="false" hidden>Theme</button>
                @if (signedIn)
                {
                    <form action="/account/logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Sign out</button>
                    </form>
                }
            </div>
        </div>
    </header>
    <main id="main-content" class="app-main" tabindex="-1">@RenderBody()</main>
</div>
@if (signedIn)
{
    <script type="module" src="~/js/navigation.js" asp-append-version="true"></script>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
