@model DashboardViewModel
@{
    ViewData["Title"] = Model.Tab switch
    {
        "processes" => ".NET monitoring",
        "postgres" => "PostgreSQL",
        "redis" => "Redis",
        "ec2" => "EC2",
        _ => "Logs"
    };
}

<div id="dashboard" data-tab="@Model.Tab" data-refresh="@Model.RefreshSeconds">
    <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
        <h1 class="h4 mb-0">@ViewData["Title"]</h1>

        @if (Model.Tab != "logs")
        {
            <span id="health-status" class="badge text-bg-secondary"></span>
            <span id="updated"
                  class="small text-secondary ms-auto"
                  aria-live="polite"></span>

            <label class="small d-flex align-items-center gap-2">
                <input id="auto-refresh" type="checkbox" checked>
                Auto refresh
            </label>

            <button id="refresh"
                    type="button"
                    class="btn btn-sm btn-outline-primary">
                Refresh
            </button>
        }
    </div>

    @if (Model.Tab == "postgres")
    {
        <div class="d-flex align-items-center gap-2 mb-3">
            <label for="postgres-database" class="small">Database</label>
            <select id="postgres-database"
                    class="form-select form-select-sm w-auto"
                    disabled>
                <option>Loading databases…</option>
            </select>
        </div>
    }

    <div id="error" class="alert alert-danger d-none" role="alert"></div>

    @if (Model.Tab == "logs")
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            @if (Model.FileLogs)
            {
                <label for="log-folder" class="small">Folder</label>

                <select id="log-folder" class="form-select form-select-sm w-auto">
                    @foreach (var folder in Model.LogFolders)
                    {
                        <option value="@folder.Url">@folder.Name</option>
                    }
                </select>

                <button id="file-logs"
                        type="button"
                        class="btn btn-sm btn-outline-primary log-source"
                        data-src="@Model.LogFolders[0].Url">
                    File logs
                </button>
            }

            @if (Model.DatabaseLogs)
            {
                <button type="button"
                        class="btn btn-sm btn-outline-primary log-source"
                        data-src="/integrations/database-logs/">
                    Database logs
                </button>
            }
        </div>

        @if (Model.FileLogs || Model.DatabaseLogs)
        {
            <iframe id="log-frame"
                    title="Log viewer"
                    class="viewer-frame"
                    src="@(Model.FileLogs ? Model.LogFolders[0].Url : "/integrations/database-logs/")">
            </iframe>
        }
        else
        {
            <p class="text-secondary">
                No log viewer is enabled. Configure a log folder or database on the server.
            </p>
        }
    }
    else if (Model.Tab == "processes")
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body d-flex flex-wrap align-items-center gap-3">
                <label for="process-view" class="small mb-0">View</label>

                <select id="process-view"
                        class="form-select form-select-sm w-auto">
                    <option value="processes">Processes</option>
                    <option value="counters">Runtime counters</option>

                    @if (Model.MonitorEnabled)
                    {
                        <option value="monitor">dotnet-monitor</option>
                    }
                    else
                    {
                        <option value="monitor" disabled>
                            dotnet-monitor — disabled
                        </option>
                    }
                </select>
            </div>
        </div>

        <section id="process-panel" aria-label="Processes">
            <div id="content" class="card border-0 shadow-sm">
                <div class="card-body text-secondary">Loading…</div>
            </div>

            <p class="small text-secondary mt-3">
                CPU is measured between refreshes; 100% equals one CPU core.
                Only accessible .NET processes are listed.
            </p>
        </section>

        <section id="counter-panel" aria-label="Runtime counters" hidden>
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <label for="counter-process" class="small mb-0">
                            Application
                        </label>

                        <select id="counter-process"
                                class="form-select form-select-sm w-auto"
                                disabled>
                            <option value="">Loading processes…</option>
                        </select>

                        <button id="counter-sample"
                                type="button"
                                class="btn btn-sm btn-outline-primary"
                                disabled>
                            Sample counters
                        </button>
                    </div>

                    <p class="small text-secondary mt-3 mb-0">
                        Select an application and collect a short runtime sample.
                        Samples run only when requested.
                    </p>
                </div>
            </div>

            <div id="counter-content" class="card border-0 shadow-sm">
                <div class="card-body text-secondary small">
                    Select an application, then choose Sample counters.
                </div>
            </div>
        </section>

        @if (Model.MonitorEnabled)
        {
            <section id="monitor-panel" aria-label="dotnet-monitor" hidden>
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <div class="d-flex flex-wrap align-items-center gap-3">
                            <label for="monitor-endpoint" class="small mb-0">
                                Data
                            </label>

                            <select id="monitor-endpoint"
                                    class="form-select form-select-sm w-auto">
                                <option value="processes">Processes</option>
                                <option value="metrics">Metrics</option>
                            </select>
                        </div>

                        <div id="monitor-metric-controls" class="mt-3" hidden>
                            <div class="d-flex flex-wrap align-items-center gap-3">
                                <label for="monitor-application" class="small mb-0">
                                    Application
                                </label>

                                <select id="monitor-application"
                                        class="form-select form-select-sm w-auto"
                                        disabled>
                                    <option value="">Loading applications…</option>
                                </select>

                                <button id="monitor-sample"
                                        type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        disabled>
                                    Sample metrics
                                </button>
                            </div>

                            <p class="small text-secondary mt-3 mb-0">
                                Collect a 10-second sample from the selected application.
                                Auto refresh updates the application list without starting samples.
                            </p>
                        </div>
                    </div>
                </div>

                <div id="monitor-content" class="card border-0 shadow-sm">
                    <div class="card-body text-secondary">
                        Select this view to load dotnet-monitor data.
                    </div>
                </div>
            </section>
        }
    }
    else
    {
        <div id="content" class="card border-0 shadow-sm">
            <div class="card-body text-secondary">Loading…</div>
        </div>
    }

    @if (Model.Tab is "postgres" or "redis")
    {
        <a class="small d-inline-block mt-3"
           href="/integrations/health"
           target="_blank"
           rel="noopener">
            Health history ↗
        </a>
    }

    @if (Model.Tab == "ec2")
    {
        <p class="small text-secondary mt-3">
            CloudWatch values are the latest available datapoints, not live readings.
            Network values are totals per configured period.
            Memory and filesystem usage require additional agent metrics.
        </p>
    }
</div>

<form id="csrf" hidden>
    @Html.AntiForgeryToken()
</form>

@section Scripts
{
    <script type="module"
            src="~/js/dashboard.js"
            asp-append-version="true"></script>
}