@model DashboardViewModel
@{
    ViewData["Title"] = Model.Tab switch
    {
        "overview" => "Overview",
        "endpoints" => "Endpoints",
        "processes" => ".NET monitoring",
        "postgres" => "PostgreSQL",
        "redis" => "Redis",
        "ec2" => "EC2",
        _ => "Logs"
    };
    var endpointsOnly = Model.Tab == "endpoints";
}

<div id="dashboard" data-tab="@Model.Tab" data-refresh="@Model.RefreshSeconds">
    <div class="dashboard-toolbar">
        <h1>@ViewData["Title"]</h1>

        @if (Model.Tab != "logs")
        {
            <div class="dashboard-actions">
                <span id="health-status" class="badge" role="status"></span>
                <span id="updated" class="text-secondary" aria-live="polite"></span>
                <label class="refresh-switch d-flex align-items-center gap-2">
                    <input id="auto-refresh" class="form-check-input m-0" type="checkbox" checked>
                    Auto refresh
                </label>
                <button id="refresh" type="button" class="btn btn-sm btn-outline-secondary">Refresh now</button>
            </div>
        }
    </div>

    @if (Model.Tab is "overview" or "endpoints")
    {
        <div id="overview-summary" class="row g-3 mb-3" role="group" aria-label="@(endpointsOnly ? "Endpoint status" : "Current monitoring status")">
            <div class="col-12 text-secondary small">@(endpointsOnly ? "Loading endpoints…" : "Loading monitored targets…")</div>
        </div>
        <div class="card mb-3">
            <div class="card-body border-bottom d-flex flex-wrap align-items-center gap-2">
                <h2 class="h6 mb-0">@(endpointsOnly ? "HTTP/HTTPS endpoints" : "Monitored targets")</h2>
                <div class="overview-controls @(endpointsOnly ? "endpoint-controls" : "")">
                    <input id="overview-search" class="form-control form-control-sm overview-search"
                           type="search" aria-label="@(endpointsOnly ? "Search endpoints" : "Search monitored targets")" placeholder="@(endpointsOnly ? "Search endpoints" : "Search targets")">
                    <label for="overview-environment" class="small">Environment</label>
                    <select id="overview-environment" class="form-select form-select-sm w-auto">
                        <option value="">All environments</option>
                    </select>
                    @if (endpointsOnly)
                    {
                        <label for="endpoint-status" class="small">Status</label>
                        <select id="endpoint-status" class="form-select form-select-sm w-auto">
                            <option value="">All statuses</option>
                            <option value="Down">Down</option>
                            <option value="Degraded">Degraded</option>
                            <option value="Unknown">Unknown</option>
                            <option value="Healthy">Healthy</option>
                        </select>
                    }
                </div>
            </div>
            <p class="table-hint text-secondary small">Scroll the table sideways to see details and history.</p>
            <div id="content" class="text-secondary card-body" role="region" aria-label="@(endpointsOnly ? "Endpoints table" : "Monitored targets table")">Loading…</div>
        </div>
        <section id="overview-history-section" class="card" aria-label="Check history" hidden>
            <div class="card-body border-bottom d-flex align-items-center gap-2">
                <h2 id="overview-history-title" class="h6 mb-0">Check history</h2>
                <button type="button" id="overview-history-close"
                        class="btn btn-sm btn-outline-secondary ms-auto">Close</button>
            </div>
            <div id="overview-history" class="card-body text-secondary">Loading…</div>
        </section>
    }

    @if (Model.Tab == "postgres")
    {
        <div class="d-flex align-items-center gap-2 mb-3">
            <label for="postgres-database" class="small">Database</label>
            <select id="postgres-database"
                    class="form-select form-select-sm w-auto"
                    disabled>
                <option>Loading databases…</option>
            </select>
        </div>
    }

    <div id="error" class="alert alert-danger d-none" role="alert"></div>

    @if (Model.Tab == "logs")
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            @if (Model.FileLogs)
            {
                <label for="log-folder" class="small">Folder</label>

                <select id="log-folder" class="form-select form-select-sm w-auto">
                    @foreach (var folder in Model.LogFolders)
                    {
                        <option value="@folder.Url">@folder.Name</option>
                    }
                </select>

                <button id="file-logs"
                        type="button"
                        class="btn btn-sm btn-outline-secondary log-source"
                        data-src="@Model.LogFolders[0].Url">
                    File logs
                </button>
            }

            @if (Model.DatabaseLogs)
            {
                <button type="button"
                        class="btn btn-sm btn-outline-secondary log-source"
                        data-src="/integrations/database-logs/">
                    Database logs
                </button>
            }
        </div>

        @if (Model.FileLogs || Model.DatabaseLogs)
        {
            <iframe id="log-frame"
                    title="Log viewer"
                    class="viewer-frame"
                    src="@(Model.FileLogs ? Model.LogFolders[0].Url : "/integrations/database-logs/")">
            </iframe>
        }
        else
        {
            <p class="text-secondary">
                No log viewer is enabled. Configure a log folder or database on the server.
            </p>
        }
    }
    else if (Model.Tab == "processes")
    {
        <div class="card mb-3">
            <div class="card-body d-flex flex-wrap align-items-center gap-3">
                <label for="process-view" class="small mb-0">View</label>

                <select id="process-view"
                        class="form-select form-select-sm w-auto">
                    <option value="processes">Processes</option>
                    <option value="counters">Runtime counters</option>

                    @if (Model.MonitorEnabled)
                    {
                        <option value="monitor">dotnet-monitor</option>
                    }
                    else
                    {
                        <option value="monitor" disabled>
                            dotnet-monitor — disabled
                        </option>
                    }
                </select>
            </div>
        </div>

        <section id="process-panel" aria-label="Processes">
            <div id="content" class="card">
                <div class="card-body text-secondary">Loading…</div>
            </div>

            <p class="small text-secondary mt-3">
                CPU is measured between refreshes; 100% equals one CPU core.
                Only accessible .NET processes are listed.
            </p>
        </section>

        <section id="counter-panel" aria-label="Runtime counters" hidden>
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <label for="counter-process" class="small mb-0">
                            Application
                        </label>

                        <select id="counter-process"
                                class="form-select form-select-sm w-auto"
                                disabled>
                            <option value="">Loading processes…</option>
                        </select>

                        <button id="counter-sample"
                                type="button"
                                class="btn btn-sm btn-outline-secondary"
                                disabled>
                            Sample counters
                        </button>
                    </div>

                    <p class="small text-secondary mt-3 mb-0">
                        Select an application and collect a short runtime sample.
                        Samples run only when requested.
                    </p>
                </div>
            </div>

            <div id="counter-content" class="card">
                <div class="card-body text-secondary small">
                    Select an application, then choose Sample counters.
                </div>
            </div>
        </section>

        @if (Model.MonitorEnabled)
        {
            <section id="monitor-panel" aria-label="dotnet-monitor" hidden>
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="d-flex flex-wrap align-items-center gap-3">
                            <label for="monitor-endpoint" class="small mb-0">
                                Data
                            </label>

                            <select id="monitor-endpoint"
                                    class="form-select form-select-sm w-auto">
                                <option value="processes">Processes</option>
                                <option value="metrics">Metrics</option>
                            </select>
                        </div>

                        <div id="monitor-metric-controls" class="mt-3" hidden>
                            <div class="d-flex flex-wrap align-items-center gap-3">
                                <label for="monitor-application" class="small mb-0">
                                    Application
                                </label>

                                <select id="monitor-application"
                                        class="form-select form-select-sm w-auto"
                                        disabled>
                                    <option value="">Loading applications…</option>
                                </select>

                                <button id="monitor-sample"
                                        type="button"
                                        class="btn btn-sm btn-outline-secondary"
                                        disabled>
                                    Sample metrics
                                </button>
                            </div>

                            <p class="small text-secondary mt-3 mb-0">
                                Collect a 10-second sample from the selected application.
                                Auto refresh updates the application list without starting samples.
                            </p>
                        </div>
                    </div>
                </div>

                <div id="monitor-content" class="card">
                    <div class="card-body text-secondary">
                        Select this view to load dotnet-monitor data.
                    </div>
                </div>
            </section>
        }
    }
    else if (Model.Tab is not ("overview" or "endpoints"))
    {
        <div id="content" class="card">
            <div class="card-body text-secondary">Loading…</div>
        </div>
    }

    @if (Model.Tab is "postgres" or "redis")
    {
        <a class="small d-inline-block mt-3"
           href="/integrations/health"
           target="_blank"
           rel="noopener">
            Health history ↗
        </a>
    }

    @if (Model.Tab == "ec2")
    {
        <p class="small text-secondary mt-3">
            CloudWatch values are the latest available datapoints, not live readings.
            Network values are totals per configured period.
            Memory and filesystem usage require additional agent metrics.
        </p>
    }
</div>

<form id="csrf" hidden>
    @Html.AntiForgeryToken()
</form>

@section Scripts
{
    <script type="module"
            src="~/js/dashboard.js"
            asp-append-version="true"></script>
}