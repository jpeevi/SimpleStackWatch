{
  "Urls": "http://127.0.0.1:5080",
  "AllowedHosts": "localhost;127.0.0.1",
  "DataDirectory": "/opt/stackwatch/data",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Dashboard": {
    "DataDirectory": "data",
    "RefreshSeconds": 10,
    "Logs": {
      "Folder": "logs",
      "EnableFileViewer": true,
      "Database": {
        "Enabled": false,
        "Schema": "public",
        "Table": "logs"
      },
      "Folders": [
        {
          "Id": "nginx",
          "Name": "Nginx",
          "Folder": "/var/log/nginx"
        }
      ]
    },
    "Processes": {
      "CountersExecutable": "dotnet-counters",
      "AllowedProcessIds": [],
      "CounterSampleSeconds": 5,
      "CommandTimeoutSeconds": 20,
      "MaximumConcurrentSamples": 2,
      "Monitor": {
        "Enabled": false,
        "BaseUrl": "http://127.0.0.1:52323",
        "ApiKey": ""
      }
    },
    "Postgres": {
      "Databases": [
        {
          "Name": "DevSolution"
        }
      ],
      "ShowQueryText": false,
      "MaximumRows": 100
    },
    "LoginRequestsPerMinute": 20
  },
  "LogSettings": {
    "FilePath": "logs/app-.log"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  }
}
