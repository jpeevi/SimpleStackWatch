{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Dashboard": {
    "DataDirectory": "data",
    "RefreshSeconds": 10,
    "Logs": {
      "Folder": "logs",
      "EnableFileViewer": true,
      "Database": {
        "Enabled": true,
        "Schema": "public",
        "Table": "logs"
      }
    },
    "Processes": {
      "CountersExecutable": "dotnet-counters",
      "AllowedProcessIds": [],
      "CounterSampleSeconds": 5,
      "CommandTimeoutSeconds": 20,
      "MaximumConcurrentSamples": 2
    },
    "Postgres": {
      "ShowQueryText": false,
      "MaximumRows": 100
    },
    "LoginRequestsPerMinute": 20
  },
  "LogSettings": {
    "FilePath": "logs/app-.log"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  }
}